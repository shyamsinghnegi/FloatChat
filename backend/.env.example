# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=floatchat

# Optional (defaults shown)
DB_HOST=localhost
DB_PORT=5432
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3
DB_POOL_RECYCLE=1800

# ── Vector Store ──────────────────────────────────────────────────────────────
CHROMA_PATH=./chroma_db

# Optional — speeds up the one-time embedding model download from Hugging Face.
# Get a free token at https://huggingface.co/settings/tokens
HF_TOKEN=your-hf-token

# ── LLM (Google Gemini) ──────────────────────────────────────────────────────
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins in production.
# Defaults to "*" (any origin) if unset — fine for local dev, tighten in production.
# Example: ALLOWED_ORIGIN=https://floatchat.vercel.app
ALLOWED_ORIGIN=*
