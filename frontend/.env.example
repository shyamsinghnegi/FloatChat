# URL of the FastAPI backend, used server-side by the Next.js API proxy routes
# (app/api/**/route.ts). Never exposed to the browser.
#
# Local dev (default if unset): http://127.0.0.1:8000
# Production: your deployed backend URL, e.g. https://floatchat-api.onrender.com
BACKEND_URL=http://127.0.0.1:8000
